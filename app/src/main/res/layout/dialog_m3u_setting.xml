<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_m3u_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA000000">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#FF263238"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M3U 直播源管理"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="勾选复选框启用/读取该源，合并接入对应分组"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/lv_m3u"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"
            android:divider="@null"
            android:dividerHeight="4dp" />

        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="正在加载并解析直播源..."
                android:textColor="#80D8FF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_add_m3u"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="添加新源"
                android:textColor="#FFFFFF"
                android:background="#009688"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <Button
                android:id="@+id/btn_close_m3u"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:text="关闭"
                android:textColor="#FFFFFF"
                android:background="#37474F"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

